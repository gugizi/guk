# config.sample.env 를 config.env 로 복사한 뒤 값을 바꾼다.
# config.env 는 git에 올리지 않는다. 비밀번호는 cnf 파일과 이 파일에만 둔다.

# 단일 인스턴스 샘플. Galera면 SOURCE_HOST 는 덤프/복제 원본 노드 S1, TARGET 쪽 cnf 호스트는 T1.
SOURCE_HOST=10.0.0.11
SOURCE_PORT=3306
TARGET_HOST=10.0.0.21
TARGET_PORT=3306

DB_NAME=appdb
CHARSET=utf8mb4

# 스크립트 디렉터리 기준 상대 경로. *.cnf.sample 을 복사해 만든다.
SOURCE_CNF=./source.cnf
TARGET_CNF=./target.cnf
DUMP_CNF=./dump.cnf
BACKUP_CNF=./backup.cnf

DUMP_FILE=/backup/appdb-full.sql
BACKUP_DIR=/backup/appdb-full
DATADIR=/var/lib/mysql

DUMP_USER=dump
DUMP_PASSWORD=change-me
REPL_USER=repl
REPL_PASSWORD=change-me
REPL_HOST=%
BACKUP_USER=backup
BACKUP_PASSWORD=change-me

# 비우면 단일 호스트. Galera 샘플은 세 노드.
# SOURCE_NODES=10.0.1.11,10.0.1.12,10.0.1.13
# TARGET_NODES=10.0.2.21,10.0.2.22,10.0.2.23
SOURCE_NODES=
TARGET_NODES=

# 덤프 헤더 또는 xtrabackup_binlog_info 에서 채운다.
# import 가 SET GLOBAL gtid_slave_pos 를 실행했다면 비워 두어도 된다.
GTID_SLAVE_POS=
BINLOG_FILE=
BINLOG_POS=

# 정확한 행 수를 비교할 테이블. 쉼표로 구분.
EXACT_COUNT_TABLES=orders
# 1 이면 EXACT_COUNT_TABLES 에 CHECKSUM TABLE 을 실행한다.
RUN_CHECKSUM=0

WATCH_COUNT=12
WATCH_INTERVAL=5

# 데이터를 지우거나 복제 정보를 리셋하거나 데이터 디렉터리를 옮기는 스크립트용.
CONFIRM=NO
# 14-galera-restore.sh 전용. 인스턴스 데이터 디렉터리 전체를 옆으로 옮긴다.
CONFIRM_DATADIR=NO

